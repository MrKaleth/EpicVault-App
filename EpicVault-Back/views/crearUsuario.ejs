<%- include("templates/cabecera", {tituloweb: 'Crear Usuario'}) %>

<div class="container">
    <h1>Crear Nuevo Usuario</h1>
    <form action="/usuarios" method="POST">
        <input type="text" name="username" placeholder="Nombre de usuario" class="form-control my-2" required>
        <input type="email" name="email" placeholder="Email" class="form-control my-2" required>
        <input type="password" name="password_hash" placeholder="Contraseña" class="form-control my-2" required>
        <input type="text" name="avatar_url" placeholder="URL del Avatar" class="form-control my-2">
        <button type="submit" class="btn btn-success btn-block">Guardar Usuario</button>
    </form>
</div>

<%- include("templates/cierre") %>