<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">
    <!-- 1. PERMISO AÑADIDO: Permite a la app salir a Internet (o a tu servidor local) -->
    <uses-permission android:name="android.permission.INTERNET" />

    <application
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.EpicVault_v2">
        <activity
            android:name=".ui.CampaignPlayActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CampaignEditActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CampaignDetailActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CampaignCreateActivity"
            android:exported="false" />
        <activity
            android:name=".ui.CampaignsActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ProfileEditActivity"
            android:exported="false" />
        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false" /> <!-- 2. PERMISO AÑADIDO: Habilita el tráfico HTTP sin encriptar para localhost -->
        <activity
            android:name=".ui.RegisterActivity"
            android:exported="false" />
        <activity
            android:name=".ui.MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />

                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <activity
            android:name=".ui.LoginActivity"
            android:exported="false" />
    </application>

</manifest>