<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="16dp"
    android:background="@color/bg_card_dark"
    android:orientation="vertical"
    android:padding="16dp"
    android:gravity="center">

    <com.google.android.material.imageview.ShapeableImageView
        android:id="@+id/ivCharAvatar"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:scaleType="centerCrop"
        app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Full"
        app:strokeColor="@color/secondary"
        app:strokeWidth="2dp" />

    <TextView
        android:id="@+id/tvCharName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="Nombre"
        android:textColor="@color/text_main_dark"
        android:textSize="18sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvCharInfo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Humano • Guerrero (Nvl. 1)"
        android:textColor="@color/text_muted_dark"
        android:textSize="14sp" />

    <TextView
        android:id="@+id/tvCharPlayer"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="👤 Jugador: Username"
        android:textColor="@color/secondary"
        android:textSize="12sp" />

    <TextView
        android:id="@+id/tvCharMoney"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="💎 0 | 🪙 0 | 🔋 0 | ⚪ 0 | 🟠 0"
        android:textAlignment="center"
        android:textColor="@color/text_main_dark"
        android:textSize="14sp"
        android:textStyle="bold" />

    <LinearLayout
        android:id="@+id/llCharActions"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:orientation="horizontal"
        android:visibility="gone">

        <Button
            android:id="@+id/btnViewSheet"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="4dp"
            android:text="Ver Ficha 📝"
            android:textColor="@color/primary" />

        <Button
            android:id="@+id/btnDeleteChar"
            style="?attr/materialButtonOutlinedStyle"
            android:layout_width="60dp"
            android:layout_height="wrap_content"
            android:text="☠️"
            android:textColor="#dc3545"
            app:strokeColor="#dc3545" />
    </LinearLayout>
</LinearLayout>