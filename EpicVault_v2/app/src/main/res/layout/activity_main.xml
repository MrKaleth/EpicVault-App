<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@color/bg_body_dark">

    <include layout="@layout/layout_navbar" />


    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:padding="16dp">

        <LinearLayout
            android:id="@+id/homeContentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="@color/bg_card_dark"
                android:padding="24dp"
                android:layout_margin="8dp"
                android:elevation="4dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Bienvenido a EpicVault"
                    android:textColor="@color/secondary"
                    android:textSize="32sp"
                    android:textStyle="bold"
                    android:gravity="center"
                    android:layout_marginBottom="16dp"/>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="¡Saludos, Aventurero! La gestión de tus campañas nunca fue tan legendaria."
                    android:textColor="@color/text_main_dark"
                    android:textSize="18sp"
                    android:gravity="center"
                    android:layout_marginBottom="32dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🎒 Inventario"
                        android:textColor="@color/secondary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Control total de objetos, peso y equipo de tus personajes."
                        android:textColor="@color/text_muted_dark"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="16dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="📝 Crónicas"
                        android:textColor="@color/secondary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Toma notas de eventos, PNJs y lugares descubiertos en tu viaje."
                        android:textColor="@color/text_muted_dark"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp"
                    android:layout_marginBottom="24dp">
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="🤖 Apoyo IA"
                        android:textColor="@color/secondary"
                        android:textSize="18sp"
                        android:textStyle="bold"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Consulta de reglas y generación de material creativo al instante."
                        android:textColor="@color/text_muted_dark"
                        android:layout_marginTop="4dp"/>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="EpicVault es una herramienta gratuita creada por y para roleros. ¿Tienes sugerencias? Contáctanos."
                    android:textColor="@color/text_muted_dark"
                    android:gravity="center"
                    android:layout_marginBottom="32dp"/>

                <Button
                    android:id="@+id/btnGestionarUsuarios"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="GESTIONAR USUARIOS 👥"
                    android:backgroundTint="#FFC107"
                    android:textColor="#000000"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnMisCampanas"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="🗡️ IR A MIS CAMPAÑAS"
                    android:backgroundTint="@color/primary"
                    android:textColor="@android:color/white"
                    android:visibility="gone"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnMiPerfil"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="MI PERFIL 👤"
                    android:textColor="@color/text_main_dark"
                    android:visibility="gone"
                    android:layout_marginBottom="16dp"/>

                <Button
                    android:id="@+id/btnEntrarBoveda"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="🔐 ENTRAR A LA BÓVEDA"
                    android:backgroundTint="@color/primary"
                    android:textColor="@android:color/white"
                    android:layout_marginBottom="8dp"/>

                <Button
                    android:id="@+id/btnCrearCuenta"
                    style="?android:attr/buttonBarButtonStyle"
                    android:layout_width="match_parent"
                    android:layout_height="60dp"
                    android:text="CREAR CUENTA"
                    android:textColor="@color/text_main_dark"/>

            </LinearLayout>

        </LinearLayout>
    </ScrollView>

</LinearLayout>