<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="60dp"
    android:orientation="horizontal"
    android:background="@color/bg_card_dark"
    android:gravity="center_vertical"
    android:paddingHorizontal="16dp"
    android:elevation="6dp">

    <TextView
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="EpicVault"
        android:textColor="@color/secondary"
        android:textSize="22sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/navThemeToggle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🌙"
        android:textSize="22sp"
        android:padding="8dp" />

    <Button
        android:id="@+id/navBtnLogin"
        android:layout_width="wrap_content"
        android:layout_height="40dp"
        android:text="🔐"
        android:backgroundTint="@color/primary"
        android:textColor="@android:color/white"
        android:layout_marginEnd="8dp" />

    <TextView
        android:id="@+id/navBellIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔"
        android:textSize="22sp"
        android:padding="8dp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/navMenuIcon"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="☰"
        android:textSize="28sp"
        android:textColor="@color/text_main_dark"
        android:paddingStart="8dp" />

</LinearLayout>